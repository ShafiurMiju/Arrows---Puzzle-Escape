{
  "name": "arrows-puzzle-escape",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test:engine": "rm -rf dist-test && tsc -p tsconfig.test.json && node --test 'dist-test/**/*.test.js'",
    "levels:generate": "tsc -p tsconfig.test.json && node scripts/emit-levels.mjs",
    "assets:icons": "node scripts/generate-placeholder-icons.mjs",
    "assets:sounds": "node scripts/generate-placeholder-sounds.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.16.2",
    "@react-navigation/native": "^7.2.5",
    "@react-navigation/native-stack": "^7.16.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-google-mobile-ads": "^16.3.3",
    "react-native-haptic-feedback": "^2.2.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-sound": "^0.11.2",
    "react-native-vector-icons": "^10.2.0",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native-community/cli": "latest",
    "@react-native/eslint-config": "^0.85.0",
    "@tsconfig/react-native": "^3.0.4",
    "@types/react": "~19.2.2",
    "@types/react-native-vector-icons": "^6.4.18",
    "eslint": "^9.0.0",
    "prettier": "^3.4.2",
    "typescript": "~6.0.3"
  }
}
