{
  "compilerOptions": {
    "strict": true,
    "target": "es2022",
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist-test",
    "noEmit": false
  },
  "include": [
    "src/game/**/*",
    "src/types/**/*",
    "src/utils/**/*",
    "src/constants/gameConfig.ts"
  ],
  "exclude": ["node_modules", "dist-test"]
}
